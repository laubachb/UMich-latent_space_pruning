# ── Raw ChIMES descriptor inputs (large; generated externally) ─────────────────
descriptors/chimes/natoms.txt
descriptors/chimes/A.txt

# ── Generated outputs (descriptor + FPS pruning runs) ─────────────────────────
descriptors/*/replicates_structure_pruning_modified/
descriptors/*/replicates_structure_pruning/
descriptors/*/structure_level_pruned/
descriptors/behler/random_replicates_structure_pruning/
random_replicates_structure_pruning/

# ── Intermediate descriptor files ─────────────────────────────────────────────
descriptors/chimes/frames_descriptors.pkl

# Cached raw (pre-standardization) structure-descriptor matrices written by each
# descriptors/*/compute_and_prune.py so the expensive descriptor evaluation runs
# only once. Regenerable; delete a .npy to force that descriptor to recompute.
descriptors/*/structure_descriptors_*.npy

# Scratch dirs left by maml/LAMMPS static calculators
descriptors/*/tmp*/

# ── Clustering descriptor cache (regenerable via clustering/compute_descriptor_matrices.py) ──
# Large per-frame descriptor matrices are cached locally but not committed (they
# require dscribe / maml+LAMMPS / ChIMES to regenerate). The small result CSVs in
# clustering/cache/ (metadata, metrics, entropy, distance stats) ARE tracked.
clustering/cache/*.npy
clustering/cache/*.csv

# ── UMAP local env / cache ────────────────────────────────────────────────────
analysis/umap/.venv/
analysis/umap/.micromamba/
analysis/umap/.conda-pkgs/
analysis/umap/.cache/
# Regenerable UMAP descriptor caches (build via unsupervised scripts; see READMEs)
analysis/umap/descriptor_cache/*.npz
analysis/umap/unsupervised/data/*.npz

# ── Python ────────────────────────────────────────────────────────────────────
.venv/
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store

# ── Editor / tooling ──────────────────────────────────────────────────────────
.claude/
*.egg-info/
dist/
build/
.env
