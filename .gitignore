# ── Data that is never committed ──────────────────────────────────────────────
# mlearn benchmark frames (public; fetched by scripts/fetch_mlearn_data.py)
external/mlearn/
# ChIMES fits of T. Sundberg (A matrices, b vectors, training trajectories, params)
external/chimes/
# any ChIMES A matrix, wherever it lives
A.txt
*_A.txt
A_*.txt
# outputs of the original Si study kept for provenance (per-descriptor scripts, cuts, caches)
legacy_si/
# the Si study's data.json (identical to external/mlearn/Si/training.json)
data.json
# manuscript drafts
writing/

# ── Results: large / regenerable files are ignored, small tables are tracked ────
results/*/descriptors/*.npy
results/*/descriptors/*.npz
results/*/logs/
results/slurm_*.log
results/*/analysis/distance_histograms.csv
results/*/analysis/embeddings.csv
results/*/analysis/quests.csv
# tracked: results/<ds>/selection/*.json (selections), results/<ds>/analysis/{composition,
# dimensionality,distance_selection}.csv, results/<ds>/descriptors/*.json (provenance)

# ── Figures: only the gnuplot publication figures are tracked ──────────────────
figures/*
!figures/*/
figures/*/*
!figures/*/fig_*.png

# ── Machine-specific tool paths ───────────────────────────────────────────────
configs/local_paths.json

# ── Python ────────────────────────────────────────────────────────────────────
.venv/
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
*.egg-info/
dist/
build/
.env

# ── Editor / OS ───────────────────────────────────────────────────────────────
.claude/
.DS_Store
*.log

# maml/LAMMPS scratch directories (created in the working directory)
tmp*/
